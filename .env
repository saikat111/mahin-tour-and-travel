# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mahintravelandtours.com

# Database Connection (MySQL for cPanel Shared Hosting)
# Note: If MySQL is not running or credentials are empty/invalid, 
# the PDO engine automatically falls back to config/database.sqlite
# ensuring the site is 100% operational immediately upon upload.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mahintravel_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Contact Phone Numbers & WhatsApp
PHONE_PRIMARY=+8801924713765
